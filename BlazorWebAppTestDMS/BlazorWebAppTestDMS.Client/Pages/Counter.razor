@page "/counter"
@rendermode InteractiveAuto

<PageTitle>Counter</PageTitle>

<h1>Counter</h1>

<p role="status">Current count: @currentCount</p>

<button class="btn btn-primary" @onclick="IncrementCount">Click me</button>

<MudSelect T="string" Placeholder="Select Test">
    <MudSelectItem T="string" Value="@("Test 1")">Test 1</MudSelectItem>
    <MudSelectItem T="string" Value="@("Test 2")">Test 2</MudSelectItem>
    <MudSelectItem T="string" Value="@("Test 3")">Test 3</MudSelectItem>
    <MudSelectItem T="string" Value="@("Test 4")">Test 4</MudSelectItem>
</MudSelect>

@code {
    private int currentCount = 0;

    private void IncrementCount()
    {
        currentCount++;
    }
    
}
